{
  "name": "chess-analysis-web",
  "version": "0.2.0",
  "private": true,
  "description": "Tablero de análisis de ajedrez en el navegador: TypeScript + chessground + Stockfish (WASM). Sin suscripciones, todo local.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-engine.mjs",
    "dev": "vite",
    "build": "node scripts/copy-engine.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "chess.js": "^1.0.0",
    "chessground": "^9.1.1",
    "stockfish": "^17.1.0"
  },
  "devDependencies": {
    "typescript": "^6.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
